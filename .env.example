# URL za CMS endpoint koji vraca galeriju (intro + categories/items)
CMS_GALLERY_ENDPOINT=

# Opcioni token/kljuc ako CMS zahteva autorizaciju (npr. Bearer token)
CMS_GALLERY_TOKEN=

# Railway PostgreSQL konekcioni string.
# Koristi PUBLIC connection string (proxy host) kada si na Vercel/van Railway mreze.
DATABASE_URL=

# Opcioni javni/proxy connection string (npr. Railway "Public Connection string").
# Ako postavis ovo, API ce ga koristiti kada primary nije dostupan.
DATABASE_URL_PUBLIC=

# Admin token za /admin i /api/admin/*
ADMIN_TOKEN=nikolamadera

# Opcioni javni token za mapu (Mapbox) ako zelis prikaz mape
NEXT_PUBLIC_MAPBOX_TOKEN=
