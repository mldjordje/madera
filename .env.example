# URL za CMS endpoint koji vraća galeriju (intro + categories/items)
CMS_GALLERY_ENDPOINT=

# Opcioni token/ključ ako CMS zahteva autorizaciju (npr. Bearer token)
CMS_GALLERY_TOKEN=

# Railway PostgreSQL konekcioni string (postavite vrednost iz Railway projekta)
DATABASE_URL=postgresql://postgres:<password>@caboose.proxy.rlwy.net:47179/railway
